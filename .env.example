# Copy to .env.local and fill in for local development.
# In production, set these in Vercel → Project Settings → Environment Variables.

# --- Core triage chat ---
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Supabase (clinics, clicks, telehealth, claims, follow-ups) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Paid doctor-connect (telehealth) ---
# Your Stripe account needs Connect enabled (Dashboard → Connect → get
# started as a platform) before provider payouts will work — see
# /api/admin/providers/connect-onboard.
STRIPE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional but recommended: enables masked "no phone numbers exchanged"
# calling via Twilio Proxy. Create a Proxy Service once in the Twilio
# console (Console → Proxy → create a Service, add a voice-capable number
# to its pool) and paste the Service SID here. Without this, the doctor
# still gets notified but only via the Doxy.me video link, not a masked
# phone call. See lib/twilio.ts createMaskedCallSession — test end-to-end
# with a trial account before relying on it for real patients.
#
# ALSO set this Proxy Service's "Callback URL" (Console → Proxy → your
# Service → Callback URL) to https://<your-domain>/api/webhooks/twilio-proxy
# — that's what triggers the provider's payout once a call completes.
# There's no API way to set this per-session, only this one-time Service
# setting.
TWILIO_PROXY_SERVICE_SID=

# Optional: auto-seeds one real row into the `providers` table on first
# request if none exists yet for a state, so you don't have to hand-write
# SQL to test the telehealth flow. See app/api/telehealth/providers/route.ts.
DEFAULT_PROVIDER_NAME=
DEFAULT_DOXY_ROOM_URL=
DEFAULT_PROVIDER_NOTIFY_PHONE=
DEFAULT_PROVIDER_PRACTICE_NAME=
DEFAULT_PROVIDER_CREDENTIALS=
DEFAULT_PROVIDER_SPECIALTY=
DEFAULT_PROVIDER_FEE_CENTS=10000
DEFAULT_PROVIDER_PAYOUT_CENTS=3000
DEFAULT_PROVIDER_NPI=
DEFAULT_PROVIDER_EMAIL=

# --- Cron auth (see vercel.json + app/api/cron/send-follow-ups) ---
# Vercel sets this automatically as a bearer token for its own Cron
# invocations when you set the same value here.
CRON_SECRET=

# --- Provider portal (see /provider/login) ---
# Uses Supabase Auth magic-link email sign-in — enabled by default on
# new Supabase projects (Authentication → Providers → Email). No new
# env vars needed beyond the Supabase ones above, but two things you
# do need to do:
#   1. In Supabase Auth settings, add your production URL to "Redirect
#      URLs" (e.g. https://urgentcare.chat/provider/auth/callback) —
#      magic links won't redirect correctly otherwise.
#   2. Set providers.email yourself when onboarding each provider (see
#      the template at the bottom of schema.sql) — providers never
#      choose their own email; it's how their login gets linked to the
#      right row on first sign-in.

# --- Admin endpoints (NPI verification, Stripe Connect onboarding) ---
# Pick a long random value; pass it as the X-Admin-Secret header when
# calling /api/admin/* routes. There's no admin UI yet — these are meant
# to be called with curl/Postman by whoever operates the platform.
ADMIN_SECRET=

# --- Not yet usable — see lib/solv.ts ---
# Requires a signed Solv Health partner agreement before it does anything.
SOLV_API_KEY=

# --- EMR documentation push — see lib/metriport.ts ---
# Sign up at metriport.com, sign their BAA, and create a "Facility" in
# their dashboard to get these. IMPORTANT: before relying on this,
# confirm directly with Metriport (and with whoever manages AFC
# Narberth's EMR) that a document pushed here will actually reach
# their eClinicalWorks chart — Metriport's core strength is pulling a
# patient's existing records IN, and this file's push-side (getting a
# note OUT to one specific organization) is a best-effort
# implementation against their documented API shape, not a verified
# integration. Test in their sandbox first.
METRIPORT_API_KEY=
METRIPORT_FACILITY_ID=
