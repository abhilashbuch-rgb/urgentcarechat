# Copy to .env.local and fill in for local development.
# In production, set these in Vercel → Project Settings → Environment Variables.

# --- Core triage chat ---
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Supabase (clinics, clicks, claims, follow-ups) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Opt-in "how did your visit go" follow-up text ---
# See lib/twilio.ts sendSms, app/api/follow-up/schedule, and
# app/api/cron/send-follow-ups.
# Twilio. Used for patient follow-up SMS and, since the alert engine,
# for OUT-OF-RANGE EXCURSION alerts to the owner and medical director.
# Excursions only — never digests or clean logs, see
# supabase/staff-alerts-sms.sql. Without these, SMS stays pending and
# visible in staff.alert_queue rather than being lost.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Cron auth (see vercel.json + app/api/cron/send-follow-ups) ---
# Vercel sets this automatically as a bearer token for its own Cron
# invocations when you set the same value here.
CRON_SECRET=

# --- Not yet usable — see lib/solv.ts ---
# Requires a signed Solv Health partner agreement before it does anything.
SOLV_API_KEY=

# --- Branded tenant subdomains (afc.urgentcare.chat, etc.) — see proxy.ts ---
# Optional access gate for tenant subdomains ONLY — root urgentcare.chat
# is never affected. Set to any random string to require
# https://<slug>.urgentcare.chat/?key=<this value> once per browser
# (sets a 30-day cookie) before that subdomain loads at all. Leave unset
# once a tenant is meant to be fully public.
TENANT_PREVIEW_KEY=

# --- Alert dispatch (owner + medical director) ---
# One provider key is enough; the first one present wins.
# Without any of these, alerts still QUEUE durably in staff.alert_queue
# and deliver once a key is set — nothing is lost, see lib/mail.ts.
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
# The From address. Must be on a domain the provider has verified.
ALERT_FROM_EMAIL=
# Shared secret for /api/cron/alerts when invoking it by hand. Vercel's
# own cron requests are recognised without it.
CRON_SECRET=
